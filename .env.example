# Copy to .env for local use: `cp .env.example .env`, then fill in your token.
# .env is in .gitignore and .dockerignore — it is never committed and never baked into the
# image. In production the platform injects these same variables directly into the
# container's environment instead, so this file is only ever read locally.

# Required. Create one on the platform: Developer page, section "Your API keys". Shown
# once — copy it immediately. Never commit it.
PLATFORM_API_TOKEN=

# Your platform instance. Defaults to http://localhost:8000 if unset.
PLATFORM_API_URL=http://localhost:8000

# Optional. Pins reads to one data version instead of always reading the latest —
# useful to reproduce a figure exactly. Leave empty for latest.
PLATFORM_DATA_VERSION=
